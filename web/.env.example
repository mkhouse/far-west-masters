# Environment variables the app needs. Copy to .env.local and fill in.
#
#   cp web/.env.example web/.env.local
#
# NAMES only — never commit values. `.env.local` is gitignored and this repository
# is public. In production these are set in the Vercel project settings, scoped to
# Production only, so that preview deployments of an unfinished branch cannot reach
# the live database or send real texts to members.

# --- Supabase -----------------------------------------------------------------
# Project URL and keys: Supabase dashboard -> Project Settings -> API keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Browser-facing key. Safe to expose: every table has row level security enabled
# with no policies, so this key can read nothing. web/scripts/check-db.mjs asserts
# exactly that — if it ever reads a member phone number, something is badly wrong.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only key that bypasses row level security. Every piece of member data the
# app reads goes through this. It must never appear in client code — lib/supabase/
# admin.ts imports 'server-only' so that a mistaken client import fails the build
# rather than shipping.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Twilio -------------------------------------------------------------------
# Console -> Account Info. The auth token also verifies webhook signatures, which
# is the only thing stopping anyone on the internet from posting fake replies.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=

# The club's toll-free sending number, E.164 format.
TWILIO_FROM_NUMBER=+1...

# Where member replies are forwarded when a message names no specific officer.
SMS_FORWARD_TO_NUMBER=+1...

# --- Deployment ---------------------------------------------------------------
# The app's own public URL — http://localhost:3000 in development.
#
# Not cosmetic. Twilio signs each webhook request over the exact URL it called, and
# both webhooks rebuild that URL from this value to check the signature. If it does
# not match the deployed URL character for character, every delivery report and
# every inbound reply is rejected with a 403 and nothing says why.
#
# It also gates delivery tracking: status callbacks are only requested when this
# starts with https://, since Twilio cannot call back to localhost.
#
# Changing the domain later means updating this, the Twilio webhook URL, and the
# Supabase Auth redirect URLs together. See RUNBOOK.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
